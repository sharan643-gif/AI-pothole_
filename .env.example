# =====================================================================
# RoadGuard AI — front-end environment
#
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# ONLY `VITE_`-prefixed variables reach the browser. Never put a secret here.
# =====================================================================

# --- Supabase (browser-safe) -----------------------------------------
# Project Settings → API → Project URL
VITE_SUPABASE_URL=
# Project Settings → API → anon/public key (protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=

# --- Map (optional) --------------------------------------------------
# A MapLibre-compatible style URL object. Left blank, RoadGuard uses the
# free CARTO dark basemap, which requires no key.
VITE_MAP_STYLE_URL=

# A Mapbox *public* token (pk.*). Only used to select a Mapbox style; the
# public token is safe to ship. Routing/turn-by-turn uses the secret token in
# the edge function instead.
VITE_MAPBOX_TOKEN=

# --- 3D globe (optional) ---------------------------------------------
# Equirectangular earth texture for the Three.js globe. Left blank, the globe
# renders a procedural sphere with a graticule — no key, no network required.
VITE_GLOBE_TEXTURE_URL=

# =====================================================================
# Gemini (server-only)
#
# The Gemini key is used ONLY by the `analyze-pothole` Edge Function, never by
# the browser. It must NOT be prefixed with VITE_ (Vite would then ship it to
# clients and leak the key). For deployed functions set it as a secret:
#
#   supabase secrets set GEMINI_API_KEY=your_key
#   supabase secrets set GEMINI_MODEL=gemini-3.5-flash-lite   # optional
#
# For `supabase functions serve` locally, put them in supabase/.env.local.
# A root-level .env entry also works if you load it with --env-file. AI analysis
# fails until a valid key is set — there is no simulated fallback.
# =====================================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# =====================================================================
# Other Edge Function secrets (never VITE_):
#
#   supabase secrets set MAPBOX_SECRET_TOKEN=pk_or_sk_token   # optional
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into edge functions automatically by the Supabase runtime.
# =====================================================================
